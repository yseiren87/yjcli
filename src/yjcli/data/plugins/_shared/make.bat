@echo off
setlocal EnableExtensions EnableDelayedExpansion
rem Generated by yjcli (managed — regenerated when platforms or plugins change).
rem Platforms: {{platforms}}
{{#if builder}}
rem Build/deploy scripts are POSIX shell (.sh) only (Docker etc. are not native to
rem Windows); those targets run through WSL.
{{/if}}

set "PLATFORMS= {{platforms}} "

if /I "%~1"=="" goto help
if /I "%~1"=="help" goto help

set "TARGET=%~1"
set "ACTION="
{{#if builder}}

set "PLATFORM=%TARGET:-build-development=%"
if /I not "%PLATFORM%"=="%TARGET%" (
  set "ACTION=build-development"
  goto parse_start
)
set "PLATFORM=%TARGET:-build-production=%"
if /I not "%PLATFORM%"=="%TARGET%" (
  set "ACTION=build-production"
  goto parse_start
)
set "PLATFORM=%TARGET:-deploy-development=%"
if /I not "%PLATFORM%"=="%TARGET%" (
  set "ACTION=deploy-development"
  goto parse_start
)
set "PLATFORM=%TARGET:-deploy-production=%"
if /I not "%PLATFORM%"=="%TARGET%" (
  set "ACTION=deploy-production"
  goto parse_start
)
{{/if}}
set "PLATFORM=%TARGET%"

:parse_start
if "!PLATFORMS: %PLATFORM% =!"=="!PLATFORMS!" (
  echo Unknown target: %TARGET%
  goto help
)

set "NAME="
shift
:parse
if "%~1"=="" goto run_exec
set "ARG=%~1"
if /I "%ARG:~0,5%"=="NAME=" set "NAME=%ARG:~5%"
shift
goto parse

:run_exec
{{#if builder}}
if defined ACTION (
  where wsl >nul 2>&1
  if errorlevel 1 (
    echo wsl.exe not found. Build/deploy scripts are .sh only; install WSL to run %ACTION% on Windows.
    exit /b 1
  )
  if not exist "tools\builder\%PLATFORM%\%ACTION%.sh" (
    echo missing: tools\builder\%PLATFORM%\%ACTION%.sh
    exit /b 1
  )
  wsl bash "tools/builder/%PLATFORM%/%ACTION%.sh" "%NAME%"
  exit /b !ERRORLEVEL!
)
{{/if}}
{{#if runner}}
if "%NAME%"=="" (
  call "tools\runner\run.bat" "%PLATFORM%"
) else (
  call "tools\runner\run.bat" "%PLATFORM%" "%NAME%"
)
exit /b %ERRORLEVEL%
{{else}}
echo Unknown target: %TARGET%
goto help
{{/if}}

:help
echo Usage:
{{#if runner}}
echo   make.bat ^<platform^>                 # all services
echo   make.bat ^<platform^> NAME=^<service^>  # one service
{{/if}}
{{#if builder}}
echo   make.bat ^<platform^>-build-development  [NAME=^<service^>]  ^(via WSL^)
echo   make.bat ^<platform^>-build-production   [NAME=^<service^>]  ^(via WSL^)
echo   make.bat ^<platform^>-deploy-development [NAME=^<service^>]  ^(via WSL^)
echo   make.bat ^<platform^>-deploy-production  [NAME=^<service^>]  ^(via WSL^)
{{/if}}
echo.
echo Platforms: {{platforms}}
exit /b 0
